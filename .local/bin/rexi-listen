#!/usr/bin/env python3
"""rexi-listen — Escucha tareas por el bot de Telegram "Rexi" y las ejecuta con Claude Code.

- Solo procesa mensajes del dueno (REXI_OWNER_ID); ignora a cualquier otro.
- Cada mensaje de texto se pasa como tarea a `claude-local`; la respuesta se
  devuelve por Telegram.
- Credenciales desde ~/.openclaw/rexi-bot.env (REXI_BOT_TOKEN, REXI_OWNER_ID, REXI_MODEL).
- Sin dependencias externas (solo stdlib). Pensado para correr bajo PM2.
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
import urllib.parse
import urllib.request

ENV_FILE = os.environ.get("REXI_ENV_FILE", os.path.expanduser("~/.openclaw/rexi-bot.env"))
OFFSET_FILE = os.path.expanduser("~/.openclaw/rexi-listen.offset")
AGENT_TIMEOUT = int(os.environ.get("REXI_AGENT_TIMEOUT", "240"))


def load_env(path: str) -> dict[str, str]:
    env: dict[str, str] = {}
    with open(path) as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("export "):
                line = line[len("export "):]
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            env[key.strip()] = value.strip().strip('"').strip("'")
    return env


env = load_env(ENV_FILE)
TOKEN = env.get("REXI_BOT_TOKEN") or ""
OWNER = str(env.get("REXI_OWNER_ID") or "").strip()
MODEL = env.get("REXI_MODEL") or "cloud-free"
CLAUDE_BIN = (
    os.environ.get("REXI_CLAUDE_BIN")
    or shutil.which("claude-local")
    or "/opt/homebrew/bin/claude-local"
)

if not TOKEN or not OWNER:
    print("rexi-listen: faltan REXI_BOT_TOKEN/REXI_OWNER_ID en", ENV_FILE, file=sys.stderr)
    sys.exit(1)

API = f"https://api.telegram.org/bot{TOKEN}"


def api(method: str, params: dict, timeout: int = 60, retries: int = 3) -> dict:
    """API call con reintentos y mejor manejo de errores."""
    for attempt in range(retries):
        try:
            data = urllib.parse.urlencode(params).encode()
            req = urllib.request.Request(f"{API}/{method}", data=data)
            req.add_header('User-Agent', 'Rexi-Bot/2.0')
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.load(resp)
        except (urllib.error.HTTPError, urllib.error.URLError) as e:
            if attempt < retries - 1:
                print(f"[RETRY] API {method} error: {e}, reintentando... ({attempt + 1}/{retries})")
                time.sleep(2 ** attempt)  # exponential backoff
            else:
                print(f"[ERROR] API {method} falló después de {retries} intentos: {e}")
                raise
        except Exception as e:
            print(f"[ERROR] API {method} exception: {e}")
            raise


def send(text: str) -> None:
    text = text if text else "(vacio)"
    for i in range(0, len(text), 3500):
        try:
            api("sendMessage", {
                "chat_id": OWNER,
                "text": text[i:i + 3500],
                "disable_web_page_preview": "true",
            })
        except Exception as exc:  # noqa: BLE001
            print(f"rexi-listen: error enviando: {exc}", file=sys.stderr)


def read_offset() -> int:
    try:
        return int(open(OFFSET_FILE).read().strip())
    except Exception:  # noqa: BLE001
        return 0


def write_offset(value: int) -> None:
    try:
        with open(OFFSET_FILE, "w") as f:
            f.write(str(value))
    except Exception:  # noqa: BLE001
        pass


def run_agent(task: str) -> str:
    try:
        proc = subprocess.run(
            [CLAUDE_BIN, task, "--ollama-model", MODEL, "--auto-confirm"],
            capture_output=True, text=True, timeout=AGENT_TIMEOUT,
        )
        out = (proc.stdout or "").strip() or (proc.stderr or "").strip()
        return out or "(sin salida)"
    except subprocess.TimeoutExpired:
        return f"⏱️ La tarea supero el limite de {AGENT_TIMEOUT}s."
    except Exception as exc:  # noqa: BLE001
        return f"Error ejecutando claude-local: {exc}"


def main() -> None:
    offset = read_offset()
    retries_failed = 0
    try:
        send(f"🟢 Rexi escuchando. Enviame una tarea y la ejecuta Claude Code (modelo: {MODEL}).")
    except Exception as exc:  # noqa: BLE001
        print(f"[WARN] No se pudo enviar mensaje inicial: {exc}", file=sys.stderr)
    while True:
        try:
            resp = api("getUpdates", {"offset": offset, "timeout": 30}, timeout=45, retries=2)
            retries_failed = 0
        except Exception as exc:  # noqa: BLE001
            retries_failed += 1
            wait_time = min(30, 5 * (2 ** (retries_failed - 1)))
            print(f"[ERROR] getUpdates fallo (intento {retries_failed}): {exc}", file=sys.stderr)
            print(f"[WAIT] Esperando {wait_time}s antes de reintentar...", file=sys.stderr)
            time.sleep(wait_time)
            continue
        if not resp.get("ok"):
            print(f"[ERROR] getUpdates not ok: {resp}", file=sys.stderr)
            time.sleep(5)
            continue
        for upd in resp.get("result", []):
            try:
                offset = upd["update_id"] + 1
                write_offset(offset)
                msg = upd.get("message") or upd.get("edited_message")
                if not msg:
                    continue
                chat_id = str(msg.get("chat", {}).get("id", ""))
                text = (msg.get("text") or "").strip()
                if chat_id != OWNER:
                    print(f"[SKIP] Mensaje de usuario no autorizado: {chat_id}", file=sys.stderr)
                    continue  # seguridad: solo el dueno
                if not text:
                    send("Por ahora solo proceso mensajes de texto.")
                    continue
                if text.lower() in ("/start", "/help"):
                    send("Hola 👋 Soy Rexi. Escribeme una tarea y la ejecuta Claude Code.")
                    continue
                print(f"[TASK] Ejecutando: {text[:80]}...", file=sys.stderr)
                send("🤖 Procesando…")
                send(run_agent(text))
            except Exception as msg_err:  # noqa: BLE001
                print(f"[ERROR] Procesando mensaje: {msg_err}", file=sys.stderr)


if __name__ == "__main__":
    main()
