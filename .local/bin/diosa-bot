#!/usr/bin/env python3
"""Diosa Bot — Telegram bot para Hermes Agent con healthcheck en puerto 9180.

- Escucha en http://127.0.0.1:9180/health para estado
- Se comunica con Hermes Agent por stdio/RPC
- Solo procesa mensajes del dueño (DIOSA_OWNER_ID)
- Credenciales desde ~/.openclaw/diosa-bot.env
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer
from threading import Thread

ENV_FILE = os.environ.get("DIOSA_ENV_FILE", os.path.expanduser("~/.openclaw/diosa-bot.env"))
OFFSET_FILE = os.path.expanduser("~/.openclaw/diosa-listen.offset")
HEALTH_PORT = int(os.environ.get("DIOSA_HEALTH_PORT", "9180"))
HEALTH_HOST = os.environ.get("DIOSA_HEALTH_HOST", "127.0.0.1")


def load_env(path: str) -> dict[str, str]:
    """Carga variables de ~/.openclaw/diosa-bot.env"""
    env: dict[str, str] = {}
    if not os.path.exists(path):
        return env
    with open(path) as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("export "):
                line = line[len("export ") :]
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            env[key.strip()] = value.strip().strip('"').strip("'")
    return env


env = load_env(ENV_FILE)
TOKEN = env.get("DIOSA_BOT_TOKEN") or ""
OWNER = str(env.get("DIOSA_OWNER_ID") or "").strip()

if not TOKEN or not OWNER:
    print(
        f"diosa-bot: faltan DIOSA_BOT_TOKEN/DIOSA_OWNER_ID en {ENV_FILE}",
        file=sys.stderr,
    )
    sys.exit(1)

API = f"https://api.telegram.org/bot{TOKEN}"
bot_ready = False
last_health_check = 0


def api(
    method: str, params: dict, timeout: int = 60, retries: int = 3
) -> dict:
    """API call con reintentos y exponential backoff."""
    for attempt in range(retries):
        try:
            data = urllib.parse.urlencode(params).encode()
            req = urllib.request.Request(f"{API}/{method}", data=data)
            req.add_header("User-Agent", "Diosa-Bot/2.0")
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.load(resp)
        except (urllib.error.HTTPError, urllib.error.URLError) as e:
            if attempt < retries - 1:
                wait = 2 ** attempt
                print(
                    f"[RETRY] API {method} error: {e}, esperando {wait}s... ({attempt + 1}/{retries})",
                    file=sys.stderr,
                )
                time.sleep(wait)
            else:
                print(
                    f"[ERROR] API {method} falló después de {retries} intentos: {e}",
                    file=sys.stderr,
                )
                raise
        except Exception as e:
            print(f"[ERROR] API {method} exception: {e}", file=sys.stderr)
            raise


def send(text: str) -> None:
    """Envía mensaje a Telegram (chunked para límite de 4096 chars)."""
    text = text if text else "(vacio)"
    for i in range(0, len(text), 3500):
        try:
            api(
                "sendMessage",
                {
                    "chat_id": OWNER,
                    "text": text[i : i + 3500],
                    "disable_web_page_preview": "true",
                },
                retries=2,
            )
        except Exception as exc:
            print(f"[ERROR] enviando mensaje: {exc}", file=sys.stderr)


def read_offset() -> int:
    """Lee último offset procesado."""
    try:
        return int(open(OFFSET_FILE).read().strip())
    except Exception:
        return 0


def write_offset(value: int) -> None:
    """Guarda último offset procesado."""
    try:
        with open(OFFSET_FILE, "w") as f:
            f.write(str(value))
    except Exception:
        pass


class HealthCheckHandler(BaseHTTPRequestHandler):
    """HTTP handler para healthcheck en puerto 9180."""

    def do_GET(self):
        """GET /health -> {status: ok}"""
        global last_health_check
        last_health_check = time.time()

        if self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(
                json.dumps(
                    {
                        "status": "ok",
                        "bot": "diosa",
                        "ready": bot_ready,
                        "timestamp": time.time(),
                    }
                ).encode()
            )
        else:
            self.send_response(404)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"error": "not found"}).encode())

    def log_message(self, format, *args):
        """Silencia logs de healthcheck"""
        pass


def run_health_server():
    """Inicia servidor HTTP de healthcheck en background."""
    server = HTTPServer((HEALTH_HOST, HEALTH_PORT), HealthCheckHandler)
    print(f"[HEALTH] Servidor en http://{HEALTH_HOST}:{HEALTH_PORT}/health")
    server.serve_forever()


def poll():
    """Polling de actualizaciones de Telegram."""
    global bot_ready
    offset = read_offset()

    try:
        send(f"🟢 Diosa online. Soy Hermes por Telegram. ¡Escribeme una tarea!")
        bot_ready = True
    except Exception as exc:
        print(f"[WARN] No se pudo enviar mensaje inicial: {exc}", file=sys.stderr)
        bot_ready = True

    retries_failed = 0
    while True:
        try:
            resp = api("getUpdates", {"offset": offset, "timeout": 30}, timeout=45, retries=2)
            retries_failed = 0
        except Exception as exc:
            retries_failed += 1
            wait = min(30, 5 * (2 ** (retries_failed - 1)))
            print(
                f"[ERROR] getUpdates fallo (intento {retries_failed}): {exc}",
                file=sys.stderr,
            )
            print(f"[WAIT] Esperando {wait}s antes de reintentar...", file=sys.stderr)
            time.sleep(wait)
            continue

        if not resp.get("ok"):
            print(f"[ERROR] getUpdates not ok: {resp}", file=sys.stderr)
            time.sleep(5)
            continue

        for upd in resp.get("result", []):
            try:
                offset = upd["update_id"] + 1
                write_offset(offset)
                msg = upd.get("message") or upd.get("edited_message")
                if not msg:
                    continue
                chat_id = str(msg.get("chat", {}).get("id", ""))
                text = (msg.get("text") or "").strip()

                if chat_id != OWNER:
                    print(
                        f"[SKIP] Mensaje de usuario no autorizado: {chat_id}",
                        file=sys.stderr,
                    )
                    continue

                if not text:
                    send("Por ahora solo proceso mensajes de texto.")
                    continue

                if text.lower() in ("/start", "/help"):
                    send(
                        "Hola 👋 Soy Diosa, el bot de Hermes. Escribeme una tarea y la ejecuta Hermes Agent."
                    )
                    continue

                print(f"[TASK] Hermes: {text[:80]}...", file=sys.stderr)
                send("🤖 Hermes procesando…")

                # Ejecutar como agente Hermes (TODO: integración real con Hermes)
                send(
                    f"⚠️ Hermes integration no implementada aún. Recibí: {text[:200]}"
                )

            except Exception as msg_err:
                print(f"[ERROR] Procesando mensaje: {msg_err}", file=sys.stderr)


def main() -> None:
    """Main entry point."""
    # Iniciar servidor de healthcheck en background
    health_thread = Thread(target=run_health_server, daemon=True)
    health_thread.start()

    print(
        f"""
╔════════════════════════════════════════════════════════════════╗
║ 🎭 DIOSA BOT v2.0 - Hermes Telegram Agent                    ║
╚════════════════════════════════════════════════════════════════╝

Configuracion:
  • Token: {TOKEN[:20]}...
  • Owner: {OWNER}
  • Health: http://{HEALTH_HOST}:{HEALTH_PORT}/health
  • Status: Iniciando...

✅ Escuchando en Telegram...
"""
    )

    try:
        poll()
    except KeyboardInterrupt:
        print("\n[STOP] Diosa detenida por usuario.", file=sys.stderr)
        sys.exit(0)
    except Exception as e:
        print(f"[FATAL] {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
